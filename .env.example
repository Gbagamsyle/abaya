# Local development placeholders only. Copy to an untracked .env and replace as required.
# Never use these placeholder values in production.

# Local PostgreSQL (docker-compose.yml)
POSTGRES_DB=fenomena
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-for-local-development
DATABASE_URL=postgresql://postgres:replace-for-local-development@localhost:5432/fenomena

# Storefront; this value is public by design.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
# Leave empty for configured Sanity/Medusa reads; set to `demo` only for local fictional QA.
CATALOGUE_MODE=

# Storefront production read adapters (server-side only)
SANITY_PROJECT_ID=replace-with-your-sanity-project-id
SANITY_DATASET=development
SANITY_API_VERSION=2025-02-19
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_KEY=replace-with-a-medusa-publishable-key
MEDUSA_REGION_ID=replace-with-a-medusa-region-id
# Set MEDUSA_PUBLISHABLE_KEY and MEDUSA_REGION_ID from the seed command output.

# Sanity Studio project configuration; project ID must be supplied before connecting.
SANITY_STUDIO_PROJECT_ID=replace-with-your-sanity-project-id
SANITY_STUDIO_DATASET=development

# Medusa; generate unique strong values locally, and use secret storage in deployed environments.
JWT_SECRET=replace-with-a-long-random-development-secret
COOKIE_SECRET=replace-with-another-long-random-development-secret
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

# Optional server-only integration configuration. Provider credentials are not enabled by this scaffold.
WHATSAPP_PHONE_NUMBER=replace-with-international-format-number
PAYMENT_PROVIDER=manual
PAYMENT_PROVIDER_SECRET=replace-only-if-a-provider-is-configured
EMAIL_PROVIDER=none
EMAIL_API_KEY=replace-only-if-an-email-provider-is-configured
