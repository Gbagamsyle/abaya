{
  "name": "fenomena-commerce",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm dev:storefront",
    "dev:storefront": "pnpm --filter @fenomena/storefront dev",
    "dev:studio": "pnpm --filter @fenomena/studio dev",
    "dev:commerce": "pnpm --filter @fenomena/commerce dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "build": "pnpm -r --if-present --workspace-concurrency=1 build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present --workspace-concurrency=1 typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.70.1",
    "typescript": "^5.8.3"
  }
}
