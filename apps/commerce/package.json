{
  "name": "@fenomena/commerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "medusa develop",
    "build": "medusa build && node scripts/copy-admin-build.mjs",
    "start": "medusa start",
    "start:server": "node scripts/start-medusa.mjs server",
    "start:worker": "node scripts/start-medusa.mjs worker",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test",
    "seed:development": "medusa exec src/scripts/seed.ts",
    "diagnose:publishable-key": "tsx src/scripts/diagnose-publishable-key.ts",
    "verify:region-payment-providers": "medusa exec src/scripts/verify-region-payment-providers.ts",
    "update:region-payment-providers": "medusa exec src/scripts/update-region-payment-providers.ts -- --dry-run",
    "initialize:publishable-key": "medusa exec src/scripts/initialize-publishable-key.ts",
    "direct:initialize:publishable-key": "tsx src/scripts/direct-publishable-key-initializer.ts",
    "copy:storefront-publishable-key": "tsx src/scripts/copy-storefront-publishable-key.ts"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "^2.21.1",
    "@medusajs/core-flows": "2.21.1",
    "@medusajs/dashboard": "^2.21.1",
    "@medusajs/draft-order": "^2.21.1",
    "@medusajs/framework": "^2.0.0",
    "@medusajs/medusa": "^2.0.0",
    "dotenv": "^18.0.5",
    "pg": "^8.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@medusajs/cli": "^2.0.0",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
